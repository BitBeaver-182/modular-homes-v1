Table "public"."organizations" {
  "id" bigint [pk, not null, increment] // internal org id
  "name" varchar(500) [not null]
  "subdomain" varchar(255) [unique, not null]
  "owner_user_id" bigint [ref: > "public"."app_users"."id"]
  "base_currency_code" "char(3)" [not null, default: 'EUR']
  "timezone" varchar(100) [not null, default: 'UTC']
  "status" varchar(50) [not null, default: 'active'] // active|archived|deleted
  "archived_at" timestamp
  "deleted_at" timestamp
  "deleted_by_user_id" bigint [ref: > "public"."app_users"."id"]
  "created_at" timestamp
  "updated_at" timestamp
}

Table "public"."organization_identities" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "provider" varchar(50) [not null] // e.g. workos|logto
  "provider_organization_id" varchar(255) [not null]
  "created_at" timestamp

  Indexes {
    (organization_id, id) [unique, name: "uq_organization_identities_org_id_id"]
    organization_id [name: "idx_organization_identities_organization_id"]
    (organization_id, provider) [unique, name: "uq_organization_identities_org_provider"]
    (provider, provider_organization_id) [unique, name: "uq_organization_identities_provider_org_id"]
  }
}

/**
Note: 
Tenant isolation is enforced with Postgres Row-Level Security (RLS).

App contract:
- Every tenant-scoped table includes `organization_id` (FK -> organizations.id)
- `app_users` is intentionally not tenant-scoped (identity lives globally), but initial policy enforces one-org-per-user via unique membership constraint
- `permissions` is intentionally global (the permission catalog is shared across all orgs)
- Auth providers are isolated behind identity tables:
  - `user_identities` maps auth-provider users -> internal `app_users`
  - `organization_identities` maps auth-provider orgs -> internal `organizations`
- The application sets a per-request org context using:
  SELECT set_config('app.organization_id', '<org_id>', true);

RLS policy template (apply to every tenant-scoped table):
  ALTER TABLE <table> ENABLE ROW LEVEL SECURITY;
  CREATE POLICY tenant_isolation ON <table>
    USING (organization_id = current_setting('app.organization_id', true))
    WITH CHECK (organization_id = current_setting('app.organization_id', true));

Notes:
- Use `set_config(..., true)` (is_local=true) inside a transaction so it clears automatically.
- For migrations/admin maintenance, use a privileged DB role (table owner) or a dedicated path that sets the org context explicitly.
- To keep user PII isolated, do not grant the app DB role direct SELECT on `app_users`; query users via `organization_memberships` joins or a security-barrier view.

*/ 

Table "public"."invoice_lines" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "invoice_id" bigint [not null, ref: > "public"."invoices"."id"]
  "description" text [not null]
  "quantity" numeric(10,2) [not null, default: 1]
  "unit_price" numeric(12,2) [not null, default: 0]
  "tax_rate" numeric(5,2) [default: 0]
  "line_total" numeric(12,2) [not null, default: 0]
  "related_house_unit_id" bigint [ref: > "public"."house_units"."id"]
  "related_supplier_order_line_id" bigint [ref: > "public"."supplier_order_lines"."id"]
  "related_customer_order_line_id" bigint [ref: > "public"."customer_order_lines"."id"]
  "created_at" timestamp

  Indexes {
    (organization_id, id) [unique, name: "uq_invoice_lines_org_id_id"]
    invoice_id [name: "idx_invoice_lines_invoice_id"]
    related_customer_order_line_id [name: "idx_invoice_lines_related_customer_order_line_id"]
    related_house_unit_id [name: "idx_invoice_lines_related_house_unit_id"]
    related_supplier_order_line_id [name: "idx_invoice_lines_related_supplier_order_line_id"]
  }
}

Table "public"."supplier_orders" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "supplier_id" bigint [not null, ref: > "public"."suppliers"."id"]
  "supplier_quote_id" bigint [ref: > "public"."supplier_quotes"."id"]
  "order_number" varchar(500)
  "supplier_po_number" varchar(500)
  "status" supplier_order_status [not null, default: 'draft']
  "order_date" date
  "confirmed_at" timestamp
  "expected_ready_date" date
  "expected_ship_date" date
  "expected_arrival_date" date
  "currency_code" "char(3)" [not null, default: 'USD']
  "subtotal_amount" numeric(12,2) [default: 0]
  "shipping_amount" numeric(12,2) [default: 0]
  "tax_amount" numeric(12,2) [default: 0]
  "total_amount" numeric(12,2) [default: 0]
  "incoterm" varchar(500)
  "payment_terms" varchar(500)
  "loading_port" varchar(500)
  "destination_port" varchar(500)
  "notes" text
  "created_by_user_id" bigint [ref: > "public"."app_users"."id"]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    (organization_id, id) [unique, name: "uq_supplier_orders_org_id_id"]
    expected_arrival_date [name: "idx_supplier_orders_expected_arrival_date"]
    order_date [name: "idx_supplier_orders_order_date"]
    order_number [name: "idx_supplier_orders_order_number"]
    (organization_id, order_number) [unique, name: "uq_supplier_orders_org_order_number"]
    status [name: "idx_supplier_orders_status"]
    supplier_id [name: "idx_supplier_orders_supplier_id"]
    supplier_quote_id [name: "idx_supplier_orders_supplier_quote_id"]
  }
}

Table "public"."invoices" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "invoice_number" varchar(500) [not null]
  "direction" invoice_direction [not null]
  "invoice_type" invoice_type [not null]
  "status" invoice_status [not null, default: 'draft']
  "supplier_id" bigint [ref: > "public"."suppliers"."id"]
  "customer_id" bigint [ref: > "public"."customers"."id"]
  "logistics_provider_id" bigint [ref: > "public"."logistics_providers"."id"]
  "supplier_order_id" bigint [ref: > "public"."supplier_orders"."id"]
  "shipment_id" bigint [ref: > "public"."shipments"."id"]
  "container_id" bigint [ref: > "public"."containers"."id"]
  "customer_order_id" bigint [ref: > "public"."customer_orders"."id"]
  "issue_date" date
  "due_date" date
  "currency_code" "char(3)" [not null, default: 'EUR']
  "exchange_rate_to_base" numeric(16,6)
  "subtotal_amount" numeric(12,2) [default: 0]
  "tax_amount" numeric(12,2) [default: 0]
  "total_amount" numeric(12,2) [not null, default: 0]
  "amount_paid" numeric(12,2) [not null, default: 0]
  "balance_due" numeric(12,2) [not null, default: 0]
  "notes" text
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    (organization_id, id) [unique, name: "uq_invoices_org_id_id"]
    (organization_id, invoice_number) [unique, name: "uq_invoices_org_invoice_number"]
    customer_id [name: "idx_invoices_customer_id"]
    customer_order_id [name: "idx_invoices_customer_order_id"]
    direction [name: "idx_invoices_direction"]
    due_date [name: "idx_invoices_due_date"]
    invoice_number [name: "idx_invoices_invoice_number"]
    invoice_type [name: "idx_invoices_invoice_type"]
    shipment_id [name: "idx_invoices_shipment_id"]
    status [name: "idx_invoices_status"]
    supplier_id [name: "idx_invoices_supplier_id"]
    supplier_order_id [name: "idx_invoices_supplier_order_id"]
  }
}

