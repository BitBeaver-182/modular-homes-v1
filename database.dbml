Table "public"."supplier_quotes" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "supplier_id" bigint [not null, ref: > "public"."suppliers"."id"]
  "quote_number" varchar(500)
  "status" supplier_quote_status [not null, default: 'received']
  "quote_date" date
  "valid_until" date
  "currency_code" "char(3)" [not null, default: 'USD']
  "subtotal_amount" numeric(12,2) [default: 0]
  "shipping_amount" numeric(12,2) [default: 0]
  "tax_amount" numeric(12,2) [default: 0]
  "total_amount" numeric(12,2) [default: 0]
  "incoterm" varchar(500)
  "payment_terms" varchar(500)
  "loading_port" varchar(500)
  "destination_port" varchar(500)
  "notes" text
  "accepted_at" timestamp
  "rejected_at" timestamp
  "accepted_by_user_id" bigint [ref: > "public"."app_users"."id"]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    (organization_id, id) [unique, name: "uq_supplier_quotes_org_id_id"]
    (organization_id, quote_number) [unique, name: "uq_supplier_quotes_org_quote_number"]
    quote_date [name: "idx_supplier_quotes_quote_date"]
    quote_number [name: "idx_supplier_quotes_quote_number"]
    status [name: "idx_supplier_quotes_status"]
    supplier_id [name: "idx_supplier_quotes_supplier_id"]
  }
}

Table "public"."marketing_campaigns" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "marketing_channel_id" bigint [ref: > "public"."marketing_channels"."id"]
  "market_id" bigint [ref: > "public"."markets"."id"]
