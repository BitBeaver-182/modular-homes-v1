    logistics_provider_id [name: "idx_shipments_logistics_provider_id"]
    shipment_number [name: "idx_shipments_shipment_number"]
    (organization_id, shipment_number) [unique, name: "uq_shipments_org_shipment_number"]
    status [name: "idx_shipments_status"]
    supplier_order_id [name: "idx_shipments_supplier_order_id"]
  }
}

Table "public"."leads" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "lead_code" varchar(500)
  "marketing_campaign_id" bigint [ref: > "public"."marketing_campaigns"."id"]
  "assigned_user_id" bigint [ref: > "public"."app_users"."id"]
  "market_id" bigint [ref: > "public"."markets"."id"]
  "preferred_language_code" varchar(3)
  "first_name" varchar(500)
  "last_name" varchar(500)
  "email" varchar(500)
  "phone" varchar(500)
  "preferred_contact_method" varchar(500)
  "status" lead_status [not null, default: 'new']
  "desired_house_model_id" bigint [ref: > "public"."house_models"."id"]
  "desired_configuration_id" bigint [ref: > "public"."product_configurations"."id"]
  "desired_delivery_city" varchar(500)
  "desired_delivery_country_code" "char(2)"
  "budget_min" numeric(12,2)
  "budget_max" numeric(12,2)
  "expected_purchase_date" date
  "source_form_url" text
  "landing_page_url" text
  "raw_payload_json" json
  "lost_reason" varchar(500)
  "notes" text
  "converted_customer_id" bigint [ref: > "public"."customers"."id"]
  "converted_at" timestamp
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    (organization_id, id) [unique, name: "uq_leads_org_id_id"]
    assigned_user_id [name: "idx_leads_assigned_user_id"]
    desired_house_model_id [name: "idx_leads_desired_house_model_id"]
    email [name: "idx_leads_email"]
    lead_code [name: "idx_leads_lead_code"]
    (organization_id, lead_code) [unique, name: "uq_leads_org_lead_code"]
    market_id [name: "idx_leads_market_id"]
    marketing_campaign_id [name: "idx_leads_marketing_campaign_id"]
    phone [name: "idx_leads_phone"]
    preferred_language_code [name: "idx_leads_preferred_language_code"]
    status [name: "idx_leads_status"]
  }
}

