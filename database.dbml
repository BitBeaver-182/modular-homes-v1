  "campaign_external_id" varchar(500)
  "utm_source" varchar(500)
  "utm_medium" varchar(500)
  "utm_campaign" varchar(500)
  "utm_content" varchar(500)
  "utm_term" varchar(500)
  "start_date" date
  "end_date" date
  "budget" numeric(12,2)
  "currency_code" "char(3)" [default: 'EUR']
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    (organization_id, id) [unique, name: "uq_marketing_campaigns_org_id_id"]
    campaign_external_id [name: "idx_marketing_campaigns_campaign_external_id"]
    market_id [name: "idx_marketing_campaigns_market_id"]
    marketing_channel_id [name: "idx_marketing_campaigns_marketing_channel_id"]
    utm_campaign [name: "idx_marketing_campaigns_utm_campaign"]
  }
}

Table "public"."customers" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "customer_code" varchar(500)
  "market_id" bigint [ref: > "public"."markets"."id"]
  "preferred_language_code" varchar(3)
  "first_name" varchar(500)
  "last_name" varchar(500)
  "company_name" varchar(500)
  "email" varchar(500)
  "phone" varchar(500)
  "tax_id" varchar(500)
  "billing_address_line_1" varchar(500)
  "billing_address_line_2" varchar(500)
  "billing_city" varchar(500)
  "billing_state_region" varchar(500)
  "billing_postal_code" varchar(500)
  "billing_country_code" "char(2)"
  "delivery_address_line_1" varchar(500)
  "delivery_address_line_2" varchar(500)
  "delivery_city" varchar(500)
  "delivery_state_region" varchar(500)
  "delivery_postal_code" varchar(500)
  "delivery_country_code" "char(2)"
  "notes" text
  "created_from_lead_id" bigint [ref: > "public"."leads"."id"]
  "created_at" timestamp
  "updated_at" timestamp

  Indexes {
    (organization_id, id) [unique, name: "uq_customers_org_id_id"]
    customer_code [name: "idx_customers_customer_code"]
    email [name: "idx_customers_email"]
    market_id [name: "idx_customers_market_id"]
    phone [name: "idx_customers_phone"]
    preferred_language_code [name: "idx_customers_preferred_language_code"]
    (organization_id, customer_code) [unique, name: "uq_customers_org_customer_code"]
  }
}

Table "public"."shipments" {
  "organization_id" bigint [not null, ref: > "public"."organizations"."id"]
  "id" bigint [pk, not null, increment]
  "supplier_order_id" bigint [not null, ref: > "public"."supplier_orders"."id"]
  "logistics_provider_id" bigint [ref: > "public"."logistics_providers"."id"]
