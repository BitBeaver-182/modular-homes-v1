{
  "name": "moduflow",
  "private": true,
  "version": "0.0.1",
  "description": "Moduflow workspace",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "build": "pnpm build:api && pnpm build:dashboard",
    "build:api": "pnpm --filter api build",
    "build:dashboard": "pnpm --filter react-dashboard build",
    "dev": "pnpm --parallel --stream --filter api --filter react-dashboard dev",
    "dev:api": "pnpm --filter api dev",
    "dev:dashboard": "pnpm --filter react-dashboard dev",
    "lint": "pnpm lint:api && pnpm lint:dashboard",
    "lint:api": "pnpm --filter api lint",
    "lint:dashboard": "pnpm --filter react-dashboard lint",
    "preview:dashboard": "pnpm --filter react-dashboard preview",
    "start": "pnpm --parallel --stream --filter api --filter react-dashboard start",
    "start:api": "pnpm --filter api start",
    "start:dashboard": "pnpm --filter react-dashboard start",
    "start:local": "pnpm dev:api",
    "test": "pnpm test:api && pnpm test:dashboard",
    "test:api": "pnpm --filter api test",
    "test:api:e2e": "pnpm --filter api test:e2e",
    "test:dashboard": "pnpm --filter react-dashboard test:unit",
    "test:dashboard:e2e": "pnpm --filter react-dashboard test:e2e",
    "test:e2e": "pnpm test:api:e2e && pnpm test:dashboard:e2e",
    "typecheck": "pnpm typecheck:api && pnpm typecheck:dashboard",
    "typecheck:api": "pnpm --filter api typecheck",
    "typecheck:dashboard": "pnpm --filter react-dashboard exec tsc --noEmit",
    "typecheck:dashboard:e2e": "pnpm --filter react-dashboard exec tsc --project tsconfig.node.json --noEmit"
  }
}
