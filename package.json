{
  "name": "moduflow-backend",
  "private": true,
  "version": "0.0.1",
  "description": "Moduflow backend workspace",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "build": "pnpm --filter api build",
    "build:api": "pnpm --filter api build",
    "build:dashboard": "pnpm --filter react-dashboard build",
    "dev:dashboard": "pnpm --filter react-dashboard dev",
    "preview:dashboard": "pnpm --filter react-dashboard preview",
    "start:local": "pnpm --filter api start:local",
    "start": "pnpm --filter api prisma:deploy && pnpm --filter api start",
    "lint": "pnpm --filter api lint",
    "lint:dashboard": "pnpm --filter react-dashboard lint",
    "typecheck": "pnpm --filter api typecheck",
    "typecheck:dashboard": "pnpm --filter react-dashboard exec tsc --noEmit",
    "test": "pnpm --filter api test",
    "test:dashboard": "pnpm --filter react-dashboard test:unit",
    "test:e2e": "pnpm --filter api test:e2e"
  }
}
