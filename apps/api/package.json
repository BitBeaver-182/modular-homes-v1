{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "contracts:build": "pnpm --filter @moduflow/types build",
    "prebuild": "pnpm contracts:build && pnpm prisma:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "openapi:generate": "NODE_ENV=local ts-node -r tsconfig-paths/register src/openapi.ts",
    "prestart:local": "NODE_ENV=local pnpm prisma:deploy",
    "dev": "pnpm start:local",
    "start": "pnpm prisma:deploy && node dist/main.js",
    "start:local": "NODE_ENV=local nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "pnpm contracts:build && pnpm prisma:generate && eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"src/generated/prisma/**\"",
    "lint:fix": "pnpm contracts:build && pnpm prisma:generate && eslint \"{src,apps,libs,test}/**/*.ts\" --ignore-pattern \"src/generated/prisma/**\" --fix",
    "typecheck": "pnpm contracts:build && pnpm prisma:generate && tsc --noEmit && tsc -p ./test/tsconfig.json --noEmit && tsc -p tsconfig.prisma.json",
    "test": "pnpm test:unit",
    "test:unit": "pnpm contracts:build && pnpm prisma:generate && jest --config ./test/jest-unit.json",
    "test:watch": "pnpm contracts:build && pnpm prisma:generate && jest --config ./test/jest-unit.json --watch",
    "test:cov": "pnpm contracts:build && pnpm prisma:generate && jest --config ./test/jest-unit.json --coverage",
    "test:debug": "pnpm contracts:build && pnpm prisma:generate && node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config ./test/jest-unit.json --runInBand",
    "test:integration": "pnpm contracts:build && pnpm prisma:generate && pnpm test:db:migrate && NODE_ENV=test jest --config ./test/jest-integration.config.js --runInBand",
    "test:e2e": "pnpm contracts:build && pnpm prisma:generate && pnpm test:db:migrate && NODE_ENV=test jest --config ./test/jest-e2e.config.js --runInBand",
    "test:db:migrate": "NODE_ENV=test prisma migrate deploy",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:db:push": "prisma db push --schema ./prisma/schema.prisma",
    "prisma:db:pull": "prisma db pull --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@moduflow/types": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-libphonenumber": "^3.2.44",
    "helmet": "^8.2.0",
    "nestjs-prisma-querybuilder": "^1.8.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
