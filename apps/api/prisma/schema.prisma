// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GovernanceRole {
  owner
  member
}

enum MembershipStatus {
  invited
  active
  removed
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
  rejected
}

enum FileUploadStatus {
  PENDING
  CONFIRMED
  ORPHANED
  DELETED
}

enum FileContext {
  AVATAR
  ORGANIZATION_LOGO
  SUPPLIER_DOCUMENT
}

enum SupplierQuoteStatus {
  received
  accepted
  rejected
}

model User {
  id           BigInt  @id @default(autoincrement())
  email        String  @unique
  passwordHash String?
  name         String?
  avatarUrl    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organizationUsers           OrganizationUser[]
  fileUploads                 FileUpload[]
  statusUpdatedSupplierQuotes SupplierQuote[] @relation("StatusUpdatedSupplierQuotes")

  @@index([deletedAt])
}

model Organization {
  id   BigInt @id @default(autoincrement())
  name String
  slug String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organizationUsers OrganizationUser[]
  invitations       OrganizationInvitation[]
  roles             Role[]
  suppliers         Supplier[]
  addresses         Address[]
  fileUploads       FileUpload[]
  supplierQuotes    SupplierQuote[]

  @@index([deletedAt])
}

model FileUpload {
  id             String           @id
  organizationId BigInt
  uploadedById   BigInt
  bucket         String
  key            String
  filename       String
  mimeType       String
  sizeBytes      Int?
  status         FileUploadStatus @default(PENDING)
  context        FileContext
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  confirmedAt    DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])
  supplierQuote SupplierQuote?

  @@index([organizationId])
  @@index([uploadedById])
}

model Address {
  id             BigInt @id @default(autoincrement())
  organizationId BigInt
  line1          String?
  line2          String?
  city           String?
  region         String?
  postalCode     String?
  countryCode    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier?

  @@index([organizationId])
  @@index([deletedAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId, city])
  @@index([organizationId, countryCode])
  @@unique([id, organizationId])
}

model Supplier {
  id             BigInt @id @default(autoincrement())
  organizationId BigInt
  addressId      BigInt? @unique
  name           String
  phoneNumber    String?
  email          String?
  website        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization   Organization   @relation(fields: [organizationId], references: [id])
  address        Address?       @relation(fields: [addressId, organizationId], references: [id, organizationId])
  supplierQuotes SupplierQuote[]

  @@index([organizationId])
  @@index([addressId])
  @@index([deletedAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId, name])
  @@index([organizationId, email])
  @@index([organizationId, phoneNumber])
  @@index([organizationId, createdAt])
  @@unique([addressId, organizationId])
}

model SupplierQuote {
  id               BigInt              @id @default(autoincrement())
  organizationId   BigInt
  supplierId       BigInt
  attachmentId     String?             @unique
  quoteNumber      String?
  status           SupplierQuoteStatus @default(received)
  quoteDate        DateTime?
  validUntil       DateTime?
  currencyCode     String              @default("USD") @db.Char(3)
  subtotalAmount   Decimal             @default(0) @db.Decimal(12, 2)
  shippingAmount   Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal             @default(0) @db.Decimal(12, 2)
  paymentTerms          String?
  notes                 String?
  statusUpdatedAt       DateTime?
  statusUpdatedByUserId BigInt?
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id])
  supplier            Supplier     @relation(fields: [supplierId], references: [id])
  attachment          FileUpload?  @relation(fields: [attachmentId], references: [id])
  statusUpdatedByUser User?        @relation("StatusUpdatedSupplierQuotes", fields: [statusUpdatedByUserId], references: [id])
  lines               SupplierQuoteLine[]

  @@unique([organizationId, id])
  @@index([organizationId, quoteNumber])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, quoteDate])
  @@index([organizationId, supplierId])
  @@index([organizationId, totalAmount])
  @@index([quoteDate])
  @@index([validUntil])
}

model SupplierQuoteLine {
  id                      BigInt  @id @default(autoincrement())
  organizationId          BigInt
  supplierQuoteId         BigInt
  houseModelId            BigInt?
  productConfigurationId  BigInt?
  description             String?
  quantity                Int     @default(1)
  unitCost                Decimal @default(0) @db.Decimal(12, 2)
  lineTotal               Decimal @default(0) @db.Decimal(12, 2)
  estimatedProductionDays Int?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  supplierQuote SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, supplierQuoteId])
  @@index([houseModelId])
  @@index([productConfigurationId])
  @@index([supplierQuoteId])
}

model OrganizationInvitation {
  id             BigInt           @id @default(autoincrement())
  organizationId BigInt
  email          String
  governanceRole GovernanceRole
  status         InvitationStatus @default(pending)
  expiresAt      DateTime?
  acceptedAt     DateTime?
  revokedAt      DateTime?
  rejectedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@index([deletedAt])
}

model OrganizationUser {
  id BigInt @id @default(autoincrement())

  userId         BigInt
  organizationId BigInt
  governanceRole GovernanceRole   @default(member)
  status         MembershipStatus @default(active)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  userRoles    UserRole[]

  @@unique([userId, organizationId], map: "OrganizationUser_userId_organizationId_key")
  @@index([userId])
  @@index([organizationId])
  @@index([deletedAt])
}

model Role {
  id             BigInt   @id @default(autoincrement())
  organizationId BigInt
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model UserRole {
  id                 BigInt   @id @default(autoincrement())
  organizationUserId BigInt
  roleId             BigInt
  createdAt          DateTime @default(now())

  organizationUser OrganizationUser @relation(fields: [organizationUserId], references: [id], onDelete: Cascade)
  role             Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([organizationUserId, roleId])
  @@index([organizationUserId])
  @@index([roleId])
}

model RolePermission {
  id           BigInt   @id @default(autoincrement())
  roleId       BigInt
  permissionId BigInt
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}
