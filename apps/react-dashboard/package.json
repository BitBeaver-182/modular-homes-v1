{
	"name": "react-dashboard",
	"private": true,
	"description": "Moduflow React dashboard",
	"license": "MIT",
	"version": "1.0.0",
	"packageManager": "pnpm@10.29.1",
	"engines": {
		"node": ">=22.0.0"
	},
	"type": "module",
	"scripts": {
		"format": "prettier \"src/**/*.{ts,tsx}\" --write",
		"lint": "eslint --max-warnings 0",
		"lint:fix": "eslint --max-warnings 0 --fix",
		"dev": "vite --host 0.0.0.0 --port 5180",
		"storybook": "storybook dev -p 6006",
		"storybook:setup": "node node_modules/@storybook/addon-styling/bin/postinstall.js",
		"storybook:build": "storybook build",
		"test": "pnpm test:unit",
		"test:all": "vitest run src/ && playwright test",
		"test:unit": "vitest src/",
		"test:unit:coverage": "vitest --coverage src/",
		"test:e2e": "playwright test",
		"test:e2e:report": "playwright show-report",
		"build": "tsc && vite build",
		"typecheck": "tsc --noEmit",
		"preview": "vite preview --host 0.0.0.0 --port 4180",
		"start": "vite preview --host 0.0.0.0 --port 4180"
	},
	"dependencies": {
		"@moduflow/types": "workspace:*",
